<Application x:Class="FrameForge.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Accent" Color="#6558F5"/>
    <Style TargetType="Window"><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="13"/><Setter Property="Background" Value="#F5F6FA"/><Setter Property="Foreground" Value="#252737"/></Style>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#F8F9FC"/><Setter Property="Foreground" Value="#36384C"/>
      <Setter Property="BorderBrush" Value="#E4E7EF"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="12,8"/><Setter Property="Margin" Value="4"/>
      <Setter Property="MinHeight" Value="36"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/><Setter Property="ToolTipService.ShowOnDisabled" Value="True"/><Setter Property="ToolTipService.InitialShowDelay" Value="350"/>
      <Setter Property="FocusVisualStyle">
        <Setter.Value><Style><Setter Property="Control.Template"><Setter.Value>
          <ControlTemplate><Border BorderBrush="#6558F5" BorderThickness="2" CornerRadius="8" Margin="-3"/></ControlTemplate>
        </Setter.Value></Setter></Style></Setter.Value>
      </Setter>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <!-- Flat surfaces; feedback stays inside a stationary hit target. -->
            <Grid Background="Transparent">
              <Grid x:Name="face" RenderTransformOrigin="0.5,0.5">
                <Border x:Name="bd" CornerRadius="6" Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                  <Grid>
                    <Border x:Name="hoverWash" CornerRadius="5" Background="#191729" Opacity="0" IsHitTestVisible="False"/>
                    <Border x:Name="clickWash" CornerRadius="5" Background="#191729" Opacity="0" IsHitTestVisible="False"/>
                    <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/>
                  </Grid>
                </Border>
              </Grid>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="hoverWash" Property="Opacity" Value="0.045"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="#BDB5EE"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="hoverWash" Property="Opacity" Value="0.14"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="#9B90F5"/>
                <Setter TargetName="face" Property="RenderTransform"><Setter.Value>
                  <ScaleTransform ScaleX="0.985" ScaleY="0.985"/>
                </Setter.Value></Setter>
              </Trigger>
              <EventTrigger RoutedEvent="Button.Click">
                <BeginStoryboard><Storyboard>
                  <DoubleAnimationUsingKeyFrames Storyboard.TargetName="clickWash" Storyboard.TargetProperty="Opacity" Duration="0:0:0.14" FillBehavior="Stop">
                    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.12"/>
                    <LinearDoubleKeyFrame KeyTime="0:0:0.14" Value="0"/>
                  </DoubleAnimationUsingKeyFrames>
                </Storyboard></BeginStoryboard>
              </EventTrigger>
              <DataTrigger Binding="{Binding Source={x:Static SystemParameters.ClientAreaAnimation}}" Value="False">
                <Setter TargetName="face" Property="RenderTransform" Value="{x:Null}"/>
                <Setter TargetName="clickWash" Property="Visibility" Value="Collapsed"/>
              </DataTrigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="face" Property="Opacity" Value="0.4"/>
                <Setter TargetName="hoverWash" Property="Opacity" Value="0"/>
                <Setter TargetName="clickWash" Property="Opacity" Value="0"/>
                <Setter Property="Cursor" Value="Arrow"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Overlay scrollbars keep the content width stable and retain a 12-DIP hit area. -->
    <ControlTemplate x:Key="QuietPageButton" TargetType="RepeatButton">
      <Border Background="Transparent"/>
    </ControlTemplate>
    <ControlTemplate x:Key="QuietVerticalThumb" TargetType="Thumb">
      <Grid Background="Transparent">
        <Border x:Name="ThumbFace" Width="4" Margin="0,2" CornerRadius="2"
                Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ScrollBar}}"/>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ThumbFace" Property="Background" Value="#6558F5"/></Trigger>
        <Trigger Property="IsDragging" Value="True"><Setter TargetName="ThumbFace" Property="Background" Value="#6558F5"/></Trigger>
        <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
          <Setter TargetName="ThumbFace" Property="Background" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
        </DataTrigger>
      </ControlTemplate.Triggers>
    </ControlTemplate>
    <ControlTemplate x:Key="QuietHorizontalThumb" TargetType="Thumb">
      <Grid Background="Transparent">
        <Border x:Name="ThumbFace" Height="4" Margin="2,0" CornerRadius="2"
                Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ScrollBar}}"/>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ThumbFace" Property="Background" Value="#6558F5"/></Trigger>
        <Trigger Property="IsDragging" Value="True"><Setter TargetName="ThumbFace" Property="Background" Value="#6558F5"/></Trigger>
        <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
          <Setter TargetName="ThumbFace" Property="Background" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
        </DataTrigger>
      </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style x:Key="QuietScrollBar" TargetType="ScrollBar">
      <Setter Property="Width" Value="12"/>
      <Setter Property="MinWidth" Value="0"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#9299A8"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid x:Name="Chrome" Background="Transparent" Opacity="0">
              <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                  <RepeatButton x:Name="PageBefore" Command="{x:Static ScrollBar.PageUpCommand}" Focusable="False" Template="{StaticResource QuietPageButton}"/>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb x:Name="ScrollThumb" MinHeight="28" Template="{StaticResource QuietVerticalThumb}"/>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton x:Name="PageAfter" Command="{x:Static ScrollBar.PageDownCommand}" Focusable="False" Template="{StaticResource QuietPageButton}"/>
                </Track.IncreaseRepeatButton>
              </Track>
            </Grid>
            <ControlTemplate.Triggers>
              <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" Value="True">
                <Setter TargetName="Chrome" Property="Opacity" Value="1"/>
              </DataTrigger>
              <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" Value="True">
                <Setter TargetName="Chrome" Property="Opacity" Value="1"/>
              </DataTrigger>
              <Trigger Property="IsMouseCaptureWithin" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="1"/></Trigger>
              <Trigger Property="Orientation" Value="Horizontal">
                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                <Setter TargetName="PageBefore" Property="Command" Value="{x:Static ScrollBar.PageLeftCommand}"/>
                <Setter TargetName="PageAfter" Property="Command" Value="{x:Static ScrollBar.PageRightCommand}"/>
                <Setter TargetName="ScrollThumb" Property="Template" Value="{StaticResource QuietHorizontalThumb}"/>
                <Setter TargetName="ScrollThumb" Property="MinHeight" Value="0"/>
                <Setter TargetName="ScrollThumb" Property="MinWidth" Value="28"/>
              </Trigger>
              <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
                <Setter TargetName="Chrome" Property="Opacity" Value="1"/>
              </DataTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Horizontal">
          <Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="12"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="QuietScrollViewer" TargetType="ScrollViewer">
      <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
      <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
      <Setter Property="PanningMode" Value="VerticalFirst"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollViewer">
            <Grid Background="{TemplateBinding Background}">
              <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                  Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                  CanContentScroll="{TemplateBinding CanContentScroll}" Margin="{TemplateBinding Padding}"/>
              <ScrollBar x:Name="PART_VerticalScrollBar" Style="{StaticResource QuietScrollBar}"
                  Orientation="Vertical" HorizontalAlignment="Right" Margin="0,2,1,2"
                  Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}"
                  Value="{Binding VerticalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"
                  Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
              <ScrollBar x:Name="PART_HorizontalScrollBar" Style="{StaticResource QuietScrollBar}"
                  Orientation="Horizontal" VerticalAlignment="Bottom" Margin="2,0,2,1"
                  Maximum="{TemplateBinding ScrollableWidth}" ViewportSize="{TemplateBinding ViewportWidth}"
                  Value="{Binding HorizontalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"
                  Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"/>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="TextBox"><Setter Property="Padding" Value="10,8"/><Setter Property="Margin" Value="4"/><Setter Property="MinHeight" Value="36"/><Setter Property="BorderBrush" Value="#DCE0EB"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style TargetType="ComboBox"><Setter Property="Padding" Value="8,6"/><Setter Property="Margin" Value="4"/><Setter Property="MinHeight" Value="36"/></Style>
    <Style TargetType="CheckBox"><Setter Property="Margin" Value="4,8"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style TargetType="Separator"><Setter Property="Margin" Value="0,12"/><Setter Property="Background" Value="#E1E4ED"/></Style>
  </Application.Resources>
</Application>
